# Development only. Run `make configure` to generate .env with random secrets.
APP_ENV=development
POSTGRES_DB=placement
POSTGRES_USER=placement
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_ISSUER=placement-api
JWT_AUDIENCE=placement-web
HTTP_PORT=8080
# Inside Compose, dependency URLs are assembled in docker-compose.yml.
# For host-side development, set DATABASE_URL, REDIS_URL and QDRANT_URL explicitly.
NEXT_PUBLIC_API_URL=/api/v1
OPENAI_API_KEY=
